# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PostgreSQL (docker compose : port 5434 → 5432)
SQL_HOST="127.0.0.1"
SQL_PORT="5434"
SQL_USER="charteforge"
SQL_PASSWORD="charteforge"
SQL_DB_NAME="charteforge"
# Compte admin pour drizzle-kit push (souvent identique en local)
SQL_ADMIN_USER="charteforge"
SQL_ADMIN_PASSWORD="charteforge"

# STRIPE_SECRET_KEY: Stripe secret key (sk_live_... or sk_test_...) for Pro subscriptions.
STRIPE_SECRET_KEY=""

# BREVO_API_KEY: Brevo transactional email API key (xkeysib-...) for email verification.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@charteforge.fr"
BREVO_SENDER_NAME="CharteForge"

# AUTH_SESSION_SECRET: Optional HMAC secret for email/password session tokens.
AUTH_SESSION_SECRET=""

# Firebase Admin (vérification des ID tokens Google côté Express).
# Télécharge un compte de service dans Firebase Console → Project settings → Service accounts,
# puis pointe vers le fichier JSON local (ne jamais committer ce fichier).
# GOOGLE_APPLICATION_CREDENTIALS="/chemin/absolu/charteforge-firebase-adminsdk.json"
# La config Web client vit dans firebase-applet-config.json (projet: charteforge).
